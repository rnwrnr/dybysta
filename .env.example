# --- Supabase (optional) ------------------------------------------------------
# Without these, DYBYSTA runs in DEMO MODE: data is stored in the browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (optional, server-side only) -----------------------------------------
# Without a key, AI features use the built-in rule-based parser and are labeled
# "Simulated AI" in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: transcription model for mixed Kazakh/Russian/English voice (falls back to whisper-1)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
